<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Host app entitlements. The embedded UPIInstrument.appex carries its own
	     (native/UPIInstrument/UPIInstrument.entitlements) and is signed
	     separately by tools/package.sh. Keep the App Group id in sync across
	     both when the Store lands. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Local development only; dropped for notarized / App Store builds. -->
	<key>com.apple.security.get-task-allow</key>
	<true/>
</dict>
</plist>
