{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UPI",
  "version": "0.1.0",
  "identifier": "com.upi.app",
  "build": {
    "frontendDist": "../web",
    "beforeBundleCommand": "bash tools/build-au.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Universal Public Instrument",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "backgroundColor": "#181818"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
