# Third-party symlinks, recreated by tools/link-third-party.sh.
# Format:  <symlink path under repo root>  <TAB or spaces>  <local source path>
# Lines starting with # are ignored. ~ expands to $HOME.
#
# NOTE: the Ravel repo URL / canonical checkout path is still an open question
# (docs/upi-app-spec.md Open Questions #6). Update the two paths below once known.

third_party/ravel/core        ~/src/ravel/core
third_party/ravel/core-dist   ~/src/ravel/core-dist
third_party/libpd             ~/src/libpd
