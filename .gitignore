# Xcode / build
native/UPI.xcodeproj/
native/.build/
build/
DerivedData/
*.xcuserstate
xcuserdata/
.DS_Store

# Rust / Tauri
target/
src-tauri/target/

# Node
node_modules/

# Local, machine-specific config
native/Local.xcconfig
tools/third-party.config.local

# Third-party symlinks (recreated by tools/link-third-party.sh)
third_party/ravel/core
third_party/ravel/core-dist
# note: third_party/libpd is a git submodule, not a symlink

# Tauri generated
src-tauri/gen/
native/.signing-identity

# DDSP model weights — large, derived from the DDSP-VST release.
# Reproduce with: bash tools/ddsp-fetch-models.sh
instrument-packs/*/backend/*.ddspw
instrument-packs/*/backend/*.ref

# Local research sandbox: a machine-specific symlink to an out-of-tree clone of
# github.com/magenta/magenta-realtime (~4 GB, own git). See note [[mrt2-sandbox]].
docs/chocolate-trumpet-sandbox
